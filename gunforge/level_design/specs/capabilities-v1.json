{
  "version": 1,
  "templates": [
    "target",
    "protected",
    "activation_source",
    "projectile",
    "decoration"
  ],
  "queries": [
    "region_contains",
    "mask_sample",
    "distance",
    "entity_age_ms"
  ],
  "algorithms": [
    "cpu-nearest-v1",
    "entity-clock60-v1"
  ],
  "entity_properties": {
    "active": "boolean",
    "visible": "boolean",
    "vx": "number",
    "vy": "number",
    "shape": [
      "rect",
      "circle"
    ],
    "z": "integer",
    "hits": "positive_integer",
    "value": "number",
    "weak_damage": "positive_integer",
    "hitstop_ms": "integer",
    "activation_cooldown_ms": "integer",
    "virtual": "boolean",
    "label": "string"
  },
  "rulesets": {
    "gallery@1": {
      "description": "score and target-recognition tasks; no compulsory lives or ammo"
    },
    "protection@1": {
      "description": "protection and intercept tasks composed from the same primitives"
    },
    "g01.paper_lantern@1": {
      "description": "First-station rules and paper-puppet renderer, explicit native migration bridge",
      "parameters_schema": "gunforge/level_design/rulesets/paper_lantern-v1.schema.json",
      "adapter_source": "gunforge/framework/core/legacy_level_adapter.gd",
