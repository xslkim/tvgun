      "native_scene": "gunforge/games/g01/scripts/alley_scene.gd",
      "module_files": [
        "gunforge/framework/core/legacy_level_adapter.gd",
        "gunforge/games/g01/scripts/alley_rules.gd",
        "gunforge/games/g01/scripts/alley_scene.gd",
        "gunforge/games/g01/scripts/alley_pose.gd",
        "gunforge/level_design/rulesets/paper_lantern_rules.gd",
        "gunforge/level_design/rulesets/paper_lantern_expand.py"
      ],
      "bridge_status": "Native presentation facade retained; spawn, warning, expiry and wave flow use the shared scheduler. Legacy second-clock domain is explicit.",
