      "actions": {"result": {"op": "complete", "result": "clear"}},
      "order": ["result"], "max_firings": 1
    },
    "jammer.pulse": {
      "trigger": {"on": "interaction.activated:jammer"},
      "actions": {"pulse": {"op": "vfx", "effect": "pulse", "entity": "jammer"}},
      "order": ["pulse"], "max_firings": 6
    }
